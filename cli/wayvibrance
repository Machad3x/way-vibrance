# wayvibrance - command line control for the Way Vibrance KWin effect.
# Run 'wayvibrance --help' for the full usage.

set -euo pipefail

usage() {
    cat <<'USAGE'
wayvibrance - digital vibrance, per-channel RGB gains and per-app profiles
for KDE Plasma on Wayland (talks to the KWin effect over D-Bus).

Usage:
  wayvibrance                        print current vibrance (0..2, 1 = neutral)
  wayvibrance 1.25                   set vibrance to 125%
  wayvibrance on | off | toggle      enable / disable / flip
  wayvibrance load                   make sure the effect is loaded in KWin
  wayvibrance rgb <r> <g> <b>        per-channel gains (e.g. 1.2 1 0.9)
  wayvibrance rgb reset              back to 1 1 1
  wayvibrance getrgb                 print current R/G/B gains
  wayvibrance primary on|off|get     restrict grading to one output
  wayvibrance primary outputs        list outputs ("name|manufacturer model WxH")
  wayvibrance primary output <name>  pick the output ('""' = automatic/first)
  wayvibrance primary output-get     current output selection
  wayvibrance app list               per-app profiles
  wayvibrance app set <pattern> <vib> [r g b]
                                     add/update a profile (e.g. firefox 1.5,
                                     or with gains: firefox 1.5 1.2 1 0.9).
                                     Quote patterns/names that contain spaces.
  wayvibrance app del <pattern>      remove one
  wayvibrance app name <pattern> <name>
                                     cosmetic label in the tray list (empty clears)
  wayvibrance app reset              remove all profiles
  wayvibrance app focused            app_id of the last focused window
  wayvibrance help | --help | -h     this text

App patterns are case-insensitive globs; '*' and '?' are wildcards.
Without a prefix the pattern matches the Wayland app_id / X11 WM_CLASS;
prefix with 'title:' to match the window caption instead. Profiles
override the global values for matching windows only — even unfocused.

Environment: QDBUS (path to a qdbus binary; auto-detected otherwise).
USAGE
}

# Help must work without a running KWin session, so answer it before
# touching D-Bus at all.
case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
esac

if [ -z "${QDBUS:-}" ]; then
    QDBUS="$(command -v qdbus6 || command -v qdbus-qt6 || command -v qdbus || echo qdbus6)"
fi
IFACE="org.wayvibrance"
EFFECTS_IFACE="org.kde.kwin.Effects"
EFFECT_ID="wayvibrance"

call() {
    "$QDBUS" "$IFACE" /Vibrance "$IFACE.$1" "${@:2}"
}

die_usage() {
    echo "usage: $*  (see: wayvibrance --help)" >&2
    exit 1
}

# KWin 6.8 hosts /Effects under the org.kde.KWin service; some setups also
# expose it as a dedicated org.kde.kwin.Effects service. Probe both.
EFFECTS_SVC=""
for svc in org.kde.KWin org.kde.kwin.Effects; do
    if "$QDBUS" "$svc" /Effects "$EFFECTS_IFACE".listOfEffects >/dev/null 2>&1; then
        EFFECTS_SVC="$svc"
        break
    fi
done

ensure_loaded() {
    [ -n "$EFFECTS_SVC" ] || { echo "could not reach KWin over D-Bus" >&2; exit 1; }
    if ! "$QDBUS" "$EFFECTS_SVC" /Effects "$EFFECTS_IFACE".isEffectLoaded "$EFFECT_ID" | grep -qi true; then
        "$QDBUS" "$EFFECTS_SVC" /Effects "$EFFECTS_IFACE".loadEffect "$EFFECT_ID" >/dev/null
        # give the effect a moment to register its D-Bus service
        for _ in 1 2 3 4 5; do
            call vibrance >/dev/null 2>&1 && return
            sleep 0.1
        done
    fi
}

cmd="${1:-get}"
case "$cmd" in
    get)
        [ $# -eq 1 ] || die_usage "wayvibrance get"
        ensure_loaded
        call vibrance
        ;;
    load)
        [ $# -eq 1 ] || die_usage "wayvibrance load"
        ensure_loaded
        ;;
    on)
        [ $# -eq 1 ] || die_usage "wayvibrance on"
        ensure_loaded
        call setEnabled true
        ;;
    off)
        [ $# -eq 1 ] || die_usage "wayvibrance off"
        ensure_loaded
        call setEnabled false
        ;;
    toggle)
        [ $# -eq 1 ] || die_usage "wayvibrance toggle"
        ensure_loaded
        call toggleEnabled
        ;;
    primary)
        ensure_loaded
        case "${2:-get}" in
            on)
                [ $# -eq 2 ] || die_usage "wayvibrance primary on"
                call setPrimaryOnly true ;;
            off)
                [ $# -eq 2 ] || die_usage "wayvibrance primary off"
                call setPrimaryOnly false ;;
            get)
                [ $# -eq 2 ] || die_usage "wayvibrance primary get"
                call primaryOnly ;;
            outputs)
                [ $# -eq 2 ] || die_usage "wayvibrance primary outputs"
                call screenList ;;
            output)
                # 'wayvibrance primary output DP-1' picks the output;
                # 'primary output ""' goes back to automatic (first output).
                # Two args keep the historical "automatic" form working.
                [ $# -le 3 ] || die_usage "wayvibrance primary output <name>"
                call setPrimaryOutputName "${3:-}"
                ;;
            output-get)
                [ $# -eq 2 ] || die_usage "wayvibrance primary output-get"
                call primaryOutputName ;;
            *)   die_usage "wayvibrance primary {on|off|get|outputs|output <name>|output-get}" ;;
        esac
        ;;
    rgb)
        ensure_loaded
        if [ "${2:-}" = "reset" ] && [ $# -eq 2 ]; then
            call setRGBGains 1 1 1
        elif [ $# -eq 4 ]; then
            call setRGBGains "$2" "$3" "$4"
        else
            echo "usage: wayvibrance rgb <red> <green> <blue>  (e.g. 1.2 1 0.9) or 'wayvibrance rgb reset'  (see: wayvibrance --help)" >&2
            exit 1
        fi
        ;;
    getrgb)
        [ $# -eq 1 ] || die_usage "wayvibrance getrgb"
        ensure_loaded
        printf 'R=%s G=%s B=%s\n' "$(call redGain)" "$(call greenGain)" "$(call blueGain)"
        ;;
    app)
        ensure_loaded
        case "${2:-list}" in
            list)
                [ $# -eq 2 ] || die_usage "wayvibrance app list"
                # each line arrives as "kind:pattern|vib[|r,g,b[|name]]" — just indent it
                call appRules | sed -e 's/^/  /' | tr -d '\r' || true
                ;;
            set)
                # Patterns containing spaces must be quoted (one argument).
                if [ $# -eq 7 ]; then
                    PATTERN="$3"
                    VIBRANCE="$4"
                    RED="$5"
                    GREEN="$6"
                    BLUE="$7"
                    call setAppRuleFull "$PATTERN" "$VIBRANCE" "$RED" "$GREEN" "$BLUE"
                elif [ $# -eq 4 ]; then
                    PATTERN="$3"
                    VIBRANCE="$4"
                    call setAppRule "$PATTERN" "$VIBRANCE"
                else
                    echo "usage: wayvibrance app set '<pattern>' <vibrance> [r g b]  (quote patterns with spaces)" >&2
                    exit 1
                fi
                ;;
            del)
                [ $# -eq 3 ] || { echo "usage: wayvibrance app del '<pattern>'  (quote patterns with spaces)" >&2; exit 1; }
                call removeAppRule "$3"
                ;;
            name)
                if [ $# -eq 3 ] || [ $# -eq 4 ]; then
                    call setAppRuleName "$3" "${4:-}"
                else
                    echo "usage: wayvibrance app name '<pattern>' '<name>'  (empty clears; quote names with spaces)" >&2
                    exit 1
                fi
                ;;
            reset)
                [ $# -eq 2 ] || die_usage "wayvibrance app reset"
                call clearAppRules
                ;;
            focused)
                [ $# -eq 2 ] || die_usage "wayvibrance app focused"
                call lastFocusedAppId
                ;;
            *)
                echo "usage: wayvibrance app {list|set|del|name|reset|focused}  (see: wayvibrance --help)" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        # positional: a numeric value, e.g. `wayvibrance 1.25`
        [ $# -eq 1 ] || { echo "usage: wayvibrance [<value> | on | off | toggle | rgb | primary | app ...]  (see: wayvibrance --help)" >&2; exit 1; }
        ensure_loaded
        call setVibrance "$cmd"
        ;;
esac
