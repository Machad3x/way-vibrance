#
# wayvibrance - command line control for the Way Vibrance KWin effect.
#
# Usage:
#   wayvibrance                    # print current value (0..2, 1 = neutral)
#   wayvibrance 1.25               # set vibrance to 125%
#   wayvibrance on | off           # enable/disable (keeps the value)
#   wayvibrance toggle             # flip between on and off
#   wayvibrance load               # make sure the effect is loaded in KWin
#   wayvibrance app list                       # per-app profiles
#   wayvibrance app set <pattern> <vib> [r g b] # e.g.: app set firefox 1.5 1.2 1 0.9
#   wayvibrance app del <pattern>              # ('title:' prefix matches the caption)
#   wayvibrance app name <pattern> <name>      # cosmetic label in the list
#   wayvibrance app reset                      # removes all profiles
#   wayvibrance app focused                    # app_id of the last focused window

set -euo pipefail

QDBUS="${QDBUS:-qdbus6}"
IFACE="org.wayvibrance"
EFFECTS_IFACE="org.kde.kwin.Effects"
EFFECT_ID="wayvibrance"

call() {
    "$QDBUS" "$IFACE" /Vibrance "$IFACE.$1" "${@:2}"
}

# KWin 6.8 hosts /Effects under the org.kde.KWin service; some setups also
# expose it as a dedicated org.kde.kwin.Effects service. Probe both.
EFFECTS_SVC=""
for svc in org.kde.KWin org.kde.kwin.Effects; do
    if "$QDBUS" "$svc" /Effects "$EFFECTS_IFACE".listOfEffects >/dev/null 2>&1; then
        EFFECTS_SVC="$svc"
        break
    fi
done

ensure_loaded() {
    [ -n "$EFFECTS_SVC" ] || { echo "could not reach KWin over D-Bus" >&2; exit 1; }
    if ! "$QDBUS" "$EFFECTS_SVC" /Effects "$EFFECTS_IFACE".isEffectLoaded "$EFFECT_ID" | grep -qi true; then
        "$QDBUS" "$EFFECTS_SVC" /Effects "$EFFECTS_IFACE".loadEffect "$EFFECT_ID" >/dev/null
        # give the effect a moment to register its D-Bus service
        for _ in 1 2 3 4 5; do
            call vibrance >/dev/null 2>&1 && return
            sleep 0.1
        done
    fi
}

cmd="${1:-get}"
case "$cmd" in
    get)
        ensure_loaded
        call vibrance
        ;;
    load)
        ensure_loaded
        ;;
    on)
        ensure_loaded
        call setEnabled true
        ;;
    off)
        ensure_loaded
        call setEnabled false
        ;;
    toggle)
        ensure_loaded
        call toggleEnabled
        ;;
    primary)
        ensure_loaded
        case "${2:-get}" in
            on)  call setPrimaryOnly true ;;
            off) call setPrimaryOnly false ;;
            get) call primaryOnly ;;
            *)   echo "usage: wayvibrance primary {on|off|get}" >&2; exit 1 ;;
        esac
        ;;
    rgb)
        ensure_loaded
        if [ "${2:-}" = "reset" ]; then
            call setRGBGains 1 1 1
        elif [ $# -ge 4 ]; then
            call setRGBGains "$2" "$3" "$4"
        else
            echo "usage: wayvibrance rgb <red> <green> <blue>  (e.g. 1.2 1 0.9) or 'wayvibrance rgb reset'" >&2
            exit 1
        fi
        ;;
    getrgb)
        ensure_loaded
        printf 'R=%s G=%s B=%s\n' "$(call redGain)" "$(call greenGain)" "$(call blueGain)"
        ;;
    app)
        ensure_loaded
        case "${2:-list}" in
            list)
                # each line arrives as "kind:pattern|vib[|r,g,b[|name]]" — just indent it
                call appRules | sed -e 's/^/  /' | tr -d '\r' || true
                ;;
            set)
                if [ $# -ge 7 ]; then
                    call setAppRuleFull "$3" "$4" "$5" "$6" "$7"
                elif [ $# -ge 4 ]; then
                    call setAppRule "$3" "$4"
                else
                    echo "usage: wayvibrance app set <pattern> <vibrance> [red green blue]  (e.g. app set firefox 1.5 | app set firefox 1.5 1.2 1 0.9)" >&2
                    exit 1
                fi
                ;;
            del)
                [ $# -ge 3 ] || { echo "usage: wayvibrance app del <pattern>" >&2; exit 1; }
                call removeAppRule "$3"
                ;;
            name)
                [ $# -ge 3 ] || { echo "usage: wayvibrance app name <pattern> <name>  (empty clears)" >&2; exit 1; }
                call setAppRuleName "$3" "${4:-}"
                ;;
            reset)
                call clearAppRules
                ;;
            focused)
                call lastFocusedAppId
                ;;
            *)
                echo "usage: wayvibrance app {list|set <pattern> <vib> [r g b]|del <pattern>|name <pattern> <name>|reset|focused}" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        # positional: a numeric value, e.g. `wayvibrance 1.25`
        ensure_loaded
        call setVibrance "$cmd"
        ;;
esac
